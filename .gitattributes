# Normalise line endings to LF for all text files so diffs stay clean across
# platforms. (Silences the "LF will be replaced by CRLF" warnings on Windows.)
* text=auto eol=lf

# Binary assets should never be normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp3 binary
*.wav binary
*.ogg binary
